#!/usr/bin/env bash
# open-session [--dry-run] <cwd> <session-id>
#
# Resume a Claude Code session in a new tab of the nearest Ghostty window: the
# most recently focused one, which gets focused (switching workspace if needed).
# With no Ghostty window open, a new terminal window is started instead.
#
# The session runs in the new tab's interactive shell on purpose: the user's bash
# `claude` wrapper pauses the folder's Remote Control service, which otherwise
# keeps running the same session. The id is handed to that shell through
# $XDG_RUNTIME_DIR/phone-sessions/next, which scripts/shell-hook.bash (sourced at
# the end of ~/.bashrc) claims. Without the hook, the command is typed instead.
set -euo pipefail

dry=0
[[ ${1:-} == --dry-run ]] && { dry=1; shift; }
cwd=${1:?usage: open-session [--dry-run] <cwd> <session-id>}
id=${2:?usage: open-session [--dry-run] <cwd> <session-id>}

[[ $id =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || { echo "bad session id: $id" >&2; exit 2; }
[[ -d $cwd ]] || { echo "no such folder: $cwd" >&2; exit 2; }

# What gets typed: no Shift characters (wtype dropped the capital in a typed folder path), and
# no folder at all; resume-here looks it up and cds with `builtin cd` (cd may be zoxide).
cmd=". $(cd "$(dirname "$0")" && pwd)/resume-here $id"

read -r addr pid < <(hyprctl clients -j | jq -r '
  [.[] | select(.class == "com.mitchellh.ghostty" and .mapped)]
  | sort_by(.focusHistoryID) | first // empty | "\(.address) \(.pid)"') || true

if ((dry)); then
  echo "window: ${addr:-none (new window)}"
  echo "command: $cmd"
  exit 0
fi

if [[ -z $addr ]]; then
  exec setsid -f uwsm-app -- xdg-terminal-exec --dir="$cwd" -- bash -ic "claude --resume $id; exec bash"
fi

# Every Ghostty tab is a live child process of the window's Ghostty process.
tabs() { ps --ppid "$pid" -o stat= | grep -vc '^Z' || true; }

handoff_dir=${XDG_RUNTIME_DIR:-/run/user/$UID}/phone-sessions
handoff=$handoff_dir/next
mkdir -p -m 700 "$handoff_dir"
(umask 077; printf '%s\n' "$id" >"$handoff.tmp") && mv -f "$handoff.tmp" "$handoff"

before=$(tabs)
hyprctl -q eval "hl.dispatch(hl.dsp.focus({ window = 'address:$addr' }))"
hyprctl -q eval "hl.dispatch(hl.dsp.send_shortcut({ mods = 'CTRL SHIFT', key = 'T', window = 'address:$addr' }))"

# The new tab's shell claims the hand-off almost at once when the hook is installed.
for _ in $(seq 100); do
  [[ -e $handoff ]] || exit 0
  sleep 0.02
done
rm -f "$handoff"

# No hook: type the command. Only once the new tab exists, or the keys land in whatever tab was open.
if (($(tabs) <= before)) || [[ $(hyprctl activewindow -j | jq -r .address) != "$addr" ]]; then
  notify-send -a "Phone Sessions" "Couldn't open a terminal tab" "Run: $cmd" 2>/dev/null || true
  exit 1
fi
wtype -- "$cmd"
wtype -k Return
