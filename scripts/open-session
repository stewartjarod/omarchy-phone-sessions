#!/usr/bin/env bash
# open-session [--dry-run] <cwd> <session-id>
#
# Resume a Claude Code session in the user's default terminal (xdg-terminal-exec):
#   - Ghostty or kitty, with scripts/shell-hook.bash sourced at the end of ~/.bashrc:
#     a new tab (Ctrl+Shift+T) in that terminal's most recently focused window, which
#     gets focused. The id is handed over through $XDG_RUNTIME_DIR/phone-sessions/next
#     and the tab's shell claims it.
#   - Anything else (Alacritty, foot, other shells, no window open): a new terminal window.
# Either way the session runs in the user's interactive shell, so shell functions such as a
# `claude` wrapper apply. Nothing is typed: wtype dropped Shift characters, and its virtual
# keymap broke send_shortcut ("key not found") until the next real key press.
set -euo pipefail

dry=0
[[ ${1:-} == --dry-run ]] && { dry=1; shift; }
cwd=${1:?usage: open-session [--dry-run] <cwd> <session-id>}
id=${2:?usage: open-session [--dry-run] <cwd> <session-id>}

[[ $id =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || { echo "bad session id: $id" >&2; exit 2; }
[[ -d $cwd ]] || { echo "no such folder: $cwd" >&2; exit 2; }

here=$(cd "$(dirname "$0")" && pwd)
name=$("$here/list-sessions" --resume-info "$id" | sed -n 2p) || true
[[ -n $name ]] || name=${cwd##*/}

handoff_dir=${XDG_RUNTIME_DIR:-/run/user/$UID}/phone-sessions
handoff=$handoff_dir/next

# Only terminals with tabs and a default Ctrl+Shift+T get the tab path. Matching the default
# terminal's class exactly also keeps Omarchy's own org.omarchy.* / TUI.* windows out.
desktop_id=$(xdg-terminal-exec --print-id 2>/dev/null || true)
desktop_id=${desktop_id%%:*}
case $desktop_id in
  com.mitchellh.ghostty.desktop) class=com.mitchellh.ghostty ;;
  kitty.desktop) class=kitty ;;
  *) class="" ;;
esac

addr=""
# The hook marks $handoff_dir/hook whenever a shell with it starts.
if [[ -n $class && -e $handoff_dir/hook ]]; then
  addr=$(hyprctl clients -j | jq -r --arg c "$class" '
    [.[] | select(.class == $c and .mapped)] | sort_by(.focusHistoryID) | first // empty | .address')
fi

open_window() {
  local sh=${SHELL:-$(getent passwd "$(id -un)" | cut -d: -f7)}
  local launch=(setsid -f)
  command -v uwsm-app >/dev/null && launch+=(uwsm-app --)
  # Id and name travel as environment variables: the name comes from a prompt and may hold
  # quotes or `$`. This -c string is valid in bash, zsh and fish.
  exec "${launch[@]}" xdg-terminal-exec --dir="$cwd" -- \
    env PHONE_SESSION_ID="$id" PHONE_SESSION_NAME="$name" "$sh" -ic \
    'claude --resume "$PHONE_SESSION_ID" --name="$PHONE_SESSION_NAME"; exec "$SHELL"'
}

if ((dry)); then
  echo "terminal: ${desktop_id:-unknown}"
  if [[ -n $addr ]]; then echo "opens: new tab in window $addr"; else echo "opens: new window"; fi
  echo "folder: $cwd"
  echo "name: $name"
  exit 0
fi

[[ -n $addr ]] || open_window

mkdir -p -m 700 "$handoff_dir"
# An unclaimed hand-off must not be picked up by some later, unrelated shell.
trap 'rm -f "$handoff" "$handoff.tmp"' EXIT
(umask 077; printf '%s\n' "$id" >"$handoff.tmp") && mv -f "$handoff.tmp" "$handoff"

hyprctl -q eval "hl.dispatch(hl.dsp.focus({ window = 'address:$addr' }))"
hyprctl -q eval "hl.dispatch(hl.dsp.send_shortcut({ mods = 'CTRL SHIFT', key = 'T', window = 'address:$addr' }))" || true

# The new tab's shell claims the hand-off as it starts.
for _ in $(seq 100); do
  [[ -e $handoff ]] || exit 0
  sleep 0.02
done

# Unclaimed (shortcut rebound, hook gone): take it back, then use a window. If taking it back
# fails, the tab's shell claimed it at the last moment and the session is already opening.
mv "$handoff" "$handoff.reclaimed" 2>/dev/null || exit 0
rm -f "$handoff.reclaimed"
open_window
