# Sourced, not run: ". <this file> <session-id>", from shell-hook.bash in a new terminal tab.
# Sourcing keeps the user's shell functions (e.g. a `claude` wrapper) in play. The session's
# folder is looked up from its transcript.

__ps_id=$1
if [[ ! $__ps_id =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
  echo "phone-sessions: bad session id: $__ps_id" >&2
elif ! __ps_info=$("$(dirname "${BASH_SOURCE[0]}")/list-sessions" --resume-info "$__ps_id"); then
  echo "phone-sessions: no transcript for session $__ps_id" >&2
elif ! { IFS= read -r __ps_dir; IFS= read -r __ps_name; } <<<"$__ps_info"; then
  echo "phone-sessions: could not read session $__ps_id" >&2
elif ! builtin cd -- "$__ps_dir"; then
  echo "phone-sessions: folder is gone: $__ps_dir" >&2
else
  # Title the tab with a builtin. The name comes from a prompt, so it never goes on a command
  # line: other local users can read those (claude --name=... would keep it there for hours).
  [[ -n $__ps_name ]] && printf '\e]2;%s\a' "$__ps_name"
  # Clean up before claude starts: it can run for hours in this shell.
  __ps_args=(--resume "$__ps_id")
  unset __ps_dir __ps_info __ps_name
  claude "${__ps_args[@]}"
fi
unset __ps_id __ps_dir __ps_info __ps_name __ps_args
