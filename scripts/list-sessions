#!/usr/bin/env python3
"""Print Claude Code sessions that were started from the phone, newest first, as JSON.

Remote Control spawns phone sessions through the SDK, so their transcripts record
entrypoint "sdk-cli"; terminal sessions record "cli". The interactive /resume
picker hides SDK sessions, which is why this plugin exists.

With --closed it prints terminal sessions that no running
Claude process holds (the terminal was closed, or the machine restarted), each with
the state it stopped in: "limit" (a usage limit stopped it), "working" (closed
mid-task) or "idle" (closed after a finished reply).
"""
import glob
import json
import os
import re
import sys
import time

# Both tabs list at most LIMIT sessions from the last MAX_AGE_DAYS, newest first.
LIMIT = 20
MAX_AGE_DAYS = 7
LIVE_SECONDS = 120
# Listing reads only a transcript's start (folder, id, first prompt) and end (title, last turn).
HEAD_LINES = 400
TAIL_BYTES = 256 * 1024
USAGE_LIMIT = re.compile(r"hit your (session|usage|weekly)( usage)? limit", re.I)


def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return " ".join(c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text")
    return ""


def is_real_prompt(text):
    t = text.strip()
    return bool(t) and not t.startswith("<")


def has_tool_use(content):
    return isinstance(content, list) and any(isinstance(c, dict) and c.get("type") == "tool_use" for c in content)


def head_and_tail(fh):
    """The first HEAD_LINES lines, then the whole lines of the last TAIL_BYTES."""
    size = os.fstat(fh.fileno()).st_size
    if size <= TAIL_BYTES * 2:
        yield from fh
        return
    for _, line in zip(range(HEAD_LINES), fh):
        yield line
    fh.seek(size - TAIL_BYTES)
    fh.readline()  # partial line
    yield from fh


def scan(path, entrypoint_wanted="sdk-cli", whole=True):
    """Folder, id, title and first prompt of one transcript; None unless its entrypoint is
    entrypoint_wanted (None accepts any). "state" says how the last turn ended. whole=False
    reads only the start and end of a long transcript."""
    entrypoint = cwd = session_id = prompt = title = last = said = None
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in (fh if whole else head_and_tail(fh)):
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if entrypoint is None and rec.get("entrypoint"):
                entrypoint = rec["entrypoint"]
                if entrypoint_wanted and entrypoint != entrypoint_wanted:
                    return None
            kind = rec.get("type")
            if kind in ("user", "assistant") and not rec.get("isSidechain"):
                content = (rec.get("message") or {}).get("content")
                if content:
                    last = (kind, has_tool_use(content))
                    if kind == "assistant" and text_of(content).strip():
                        said = text_of(content)
            if kind in ("custom-title", "ai-title"):
                value = rec.get("customTitle") or rec.get("aiTitle") or rec.get("title")
                # A name the user gave wins over a generated one.
                if value and (kind == "custom-title" or not title or not title[1]):
                    title = (value, kind == "custom-title")
            if kind == "user" and not rec.get("isSidechain"):
                cwd = cwd or rec.get("cwd")
                session_id = session_id or rec.get("sessionId")
                if prompt is None:
                    text = text_of((rec.get("message") or {}).get("content"))
                    if is_real_prompt(text):
                        prompt = " ".join(text.split())[:240]
    if (entrypoint_wanted and entrypoint != entrypoint_wanted) or not cwd or not session_id:
        return None
    if said and USAGE_LIMIT.search(said):
        state = "limit"
    elif last == ("assistant", False):
        state = "idle"
    else:
        state = "working"
    return {"id": session_id, "cwd": cwd, "title": title[0] if title else "", "prompt": prompt or "",
            "state": state}


def proc_start(pid):
    """The process's start time in clock ticks, or None if it is gone."""
    try:
        with open("/proc/%d/stat" % pid) as fh:
            stat = fh.read()
    except OSError:
        return None
    # Field 2 is the command name in parentheses and may itself contain spaces or ")".
    fields = stat[stat.rfind(")") + 2:].split()
    return fields[19] if len(fields) > 19 else None


def running_ids(config):
    """Session ids a live Claude process holds. Claude writes sessions/<pid>.json for each
    running session; a record whose pid died, or was reused after a reboot, does not count."""
    ids = set()
    for path in glob.glob(os.path.join(config, "sessions", "*.json")):
        try:
            with open(path) as fh:
                rec = json.load(fh)
            start = proc_start(int(rec["pid"]))
            if start is not None and start == str(rec.get("procStart")):
                ids.add(rec["sessionId"])
        except (OSError, ValueError, KeyError, TypeError):
            continue
    return ids


def tab_name(info, limit=40):
    """Short name for the terminal tab: the session's title, else the start of its first prompt."""
    text = info["title"] or info["prompt"] or os.path.basename(info["cwd"].rstrip("/")) or "Claude session"
    if len(text) <= limit:
        return text
    cut = text[:limit].rsplit(" ", 1)[0] or text[:limit]
    return cut.rstrip(" .,;:-") + "…"


def printable(text):
    """Drop control characters, so a name can't end or inject a terminal escape sequence."""
    return "".join(" " if ord(c) < 32 or 0x7F <= ord(c) < 0xA0 else c for c in text)


def resume_info(root, session_id):
    for path in glob.glob(os.path.join(root, "*", glob.escape(session_id) + ".jsonl")):
        info = scan(path, entrypoint_wanted=None)
        if info:
            return info
    return None


def main():
    home = os.path.expanduser("~")
    config = os.environ.get("CLAUDE_CONFIG_DIR", os.path.join(home, ".claude"))
    root = os.path.join(config, "projects")

    # list-sessions --resume-info <id>: the session's folder, then a tab name (used by resume-here).
    # list-sessions --set-title <id>: set the terminal's title to the tab name (used by open-session).
    # The name comes from a prompt, so it is never put on a command line (other users can read those).
    if len(sys.argv) == 3 and sys.argv[1] in ("--resume-info", "--set-title"):
        info = resume_info(root, sys.argv[2])
        if not info:
            sys.exit(1)
        if sys.argv[1] == "--set-title":
            sys.stdout.write("\033]2;" + printable(tab_name(info)) + "\007")
            return
        print(info["cwd"])
        print(printable(tab_name(info)))
        return

    closed = sys.argv[1:] == ["--closed"]
    now = time.time()
    running = running_ids(config) if closed else set()

    files = []
    for path in glob.glob(os.path.join(root, "*", "*.jsonl")):
        try:
            st = os.stat(path)
        except OSError:
            continue
        if not st.st_size:
            continue
        # Cheap filters first: transcripts can be many megabytes.
        if now - st.st_mtime > MAX_AGE_DAYS * 86400 or os.path.basename(path)[:-len(".jsonl")] in running:
            continue
        files.append((st.st_mtime, path))
    files.sort(reverse=True)

    out = []
    for mtime, path in files:
        try:
            info = scan(path, "cli" if closed else "sdk-cli", whole=False)
        except OSError:
            continue
        if not info or not os.path.isdir(info["cwd"]) or info["id"] in running:
            continue
        cwd = info["cwd"]
        info["folder"] = "~" + cwd[len(home):] if cwd == home or cwd.startswith(home + "/") else cwd
        info["mtime"] = int(mtime)
        # "live" means running on the phone; a closed terminal session never is.
        info["live"] = not closed and now - mtime < LIVE_SECONDS
        if not closed:
            del info["state"]
        out.append(info)
        if len(out) >= LIMIT:
            break
    json.dump(out, sys.stdout)


if __name__ == "__main__":
    main()
